{
  "name": "@vinicunca/commitlint-config",
  "type": "module",
  "version": "1.0.0",
  "description": "Shared commitlint and cz-git config with workspace-aware scopes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinicunca/taman.git",
    "directory": "internal/lint-configs/commitlint-config"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    }
  },
  "main": "./index.mjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "files": [
    "index.d.ts",
    "index.mjs"
  ],
  "peerDependencies": {
    "@commitlint/cli": "^21.0.0",
    "czg": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "czg": {
      "optional": true
    }
  },
  "dependencies": {
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/types": "catalog:",
    "@vinicunca/node-utils": "workspace:^",
    "commitlint-plugin-function-rules": "catalog:"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "cz-git": "catalog:",
    "czg": "catalog:"
  }
}
