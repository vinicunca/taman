{
  "name": "@vinicunca/node-utils",
  "type": "module",
  "version": "1.0.1",
  "description": "Node.js build helpers and explicit pnpm workspace utilities.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinicunca/taman.git",
    "directory": "internal/node-utils"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "stub": "node ./scripts/build.mjs",
    "build": "node ./scripts/build.mjs",
    "test": "vitest run --config vitest.config.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@internationalized/date": "catalog:",
    "@manypkg/get-packages": "catalog:",
    "chalk": "catalog:",
    "consola": "catalog:",
    "execa": "catalog:",
    "pkg-types": "catalog:"
  }
}
