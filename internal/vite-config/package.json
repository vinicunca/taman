{
  "name": "@vinicunca/vite-config",
  "type": "module",
  "version": "1.0.1",
  "description": "Opinionated Vite config for Vue applications and libraries.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinicunca/taman.git",
    "directory": "internal/vite-config"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm exec tsdown",
    "prepublishOnly": "pnpm build",
    "stub": "pnpm exec tsdown",
    "watch": "pnpm exec tsdown --watch"
  },
  "peerDependencies": {
    "unocss": "^66.0.0",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "@intlify/unplugin-vue-i18n": "catalog:",
    "@jspm/generator": "catalog:",
    "@pnpm/workspace.read-manifest": "catalog:",
    "@types/html-minifier-terser": "catalog:",
    "@vinicunca/node-utils": "workspace:^",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "archiver": "catalog:",
    "cheerio": "catalog:",
    "dotenv": "catalog:",
    "html-minifier-terser": "catalog:",
    "rollup-plugin-visualizer": "catalog:",
    "unplugin-dts": "catalog:",
    "vite-plugin-compression": "catalog:",
    "vite-plugin-pwa": "catalog:",
    "vite-plugin-vue-devtools": "catalog:"
  },
  "devDependencies": {
    "@types/archiver": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:"
  }
}
