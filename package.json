{
  "name": "@taman/monorepo",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "^22.18.0 || ^24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "bootstrap": "pnpm install",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 turbo build",
    "build:analyze": "turbo build:analyze",
    "build:docker": "./scripts/deploy/build-local-docker-image.sh",
    "check": "pnpm run check:circular && pnpm run check:dep && pnpm run check:type && pnpm check:cspell",
    "check:api-packages": "bash ./scripts/release/check-api-packages.sh",
    "check:circular": "pnpm nx run tooling:check-circular",
    "check:cspell": "cspell lint \"**/*.ts\" \"**/README.md\" --no-progress",
    "check:dep": "pnpm nx run tooling:check-dep",
    "check:type": "turbo run typecheck",
    "clean": "node ./scripts/clean.mjs",
    "commit": "czg",
    "dev:web": "pnpm nx run web:dev",
    "dev:api": "pnpm nx run api:dev",
    "dev:db-pg:studio": "pnpm nx run db-pg:studio:dev",
    "format": "pnpm nx run tooling:lint:format",
    "lint": "pnpm nx run tooling:lint",
    "nx": "nx",
    "postinstall": "pnpm -r run --if-present stub",
    "preinstall": "npx only-allow pnpm",
    "prepare": "is-ci || pnpm exec lefthook install",
    "publint": "pnpm nx run tooling:publint",
    "reinstall": "pnpm run clean -- --del-lock && pnpm install",
    "test:unit": "vitest run --dom",
    "test:core": "vitest packages",
    "test": "vitest",
    "db:generate": "pnpm nx run db-pg:generate",
    "db:generate:auth": "pnpm nx run db-pg:generate:auth",
    "db-pg:migrate:dev": "pnpm nx run db-pg:migrate",
    "db-pg:migrate:uat": "pnpm nx run db-pg:migrate:uat",
    "db-pg:migrate:prod": "pnpm nx run db-pg:migrate:prod",
    "catalog": "pnpm dlx codemod pnpm/catalog"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@changesets/cli": "catalog:",
    "@commitlint/cli": "catalog:",
    "@types/node": "catalog:",
    "@vinicunca/commitlint-config": "workspace:*",
    "@vinicunca/eslint-config": "catalog:",
    "@vinicunca/tsconfig": "workspace:*",
    "@vinicunca/vite-config": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "cross-env": "catalog:",
    "cspell": "catalog:",
    "czg": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "is-ci": "catalog:",
    "lefthook": "catalog:",
    "nx": "catalog:",
    "playwright": "catalog:",
    "pohon-ui": "catalog:",
    "publint": "catalog:",
    "rimraf": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  }
}
