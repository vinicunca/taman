{
  "name": "@vinicunca/request",
  "type": "module",
  "version": "0.1.0",
  "description": "Generic typed request clients: oRPC and ofetch-based REST, each with TanStack Query helpers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinicunca/taman.git",
    "directory": "packages/request"
  },
  "sideEffects": false,
  "exports": {
    "./orpc": "./src/orpc.ts",
    "./orpc-query": "./src/orpc-query.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      "./orpc": {
        "types": "./dist/orpc.d.mts",
        "default": "./dist/orpc.mjs"
      },
      "./orpc-query": {
        "types": "./dist/orpc-query.d.mts",
        "default": "./dist/orpc-query.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@tanstack/query-core": ">=5.80.2"
  },
  "peerDependenciesMeta": {
    "@tanstack/query-core": {
      "optional": true
    }
  },
  "dependencies": {
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/tanstack-query": "catalog:"
  },
  "devDependencies": {
    "@orpc/server": "catalog:",
    "@tanstack/query-core": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
