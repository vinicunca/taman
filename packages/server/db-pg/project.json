{
  "name": "db-pg",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/server/db-pg",
  "projectType": "library",
  "targets": {
    "studio": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ./scripts/run-studio.sh",
        "cwd": "packages/server/db-pg"
      },
      "defaultConfiguration": "dev",
      "configurations": {
        "dev": {
          "envFile": "packages/server/db-pg/.env",
          "env": {
            "MODE_ENV": "dev"
          }
        },
        "uat": {
          "envFile": "packages/server/db-pg/.env.uat",
          "env": {
            "MODE_ENV": "uat"
          }
        },
        "prod": {
          "envFile": "packages/server/db-pg/.env.prod",
          "env": {
            "MODE_ENV": "prod"
          }
        }
      },
      "cache": false
    },
    "generate": {
      "command": "pnpm drizzle-kit generate",
      "options": {
        "cwd": "packages/server/db-pg"
      },
      "cache": false
    },
    "generate:auth": {
      "command": "pnpx @better-auth/cli generate --config ./gen-auth-schema.ts --output ./src/schema/auth.schema.ts -y",
      "options": {
        "cwd": "packages/server/db-pg"
      },
      "cache": false
    },

    "migrate": {
      "executor": "nx:run-commands",
      "options": {
        "parallel": false,
        "cwd": "packages/server/db-pg"
      },
      "defaultConfiguration": "dev",
      "configurations": {
        "dev": {
          "envFile": "packages/server/db-pg/.env",
          "commands": [
            "drizzle-kit push"
          ]
        },
        "uat": {
          "envFile": "packages/server/db-pg/.env.uat",
          "commands": [
            "drizzle-kit migrate"
          ]
        },
        "prod": {
          "envFile": "packages/server/db-pg/.env.prod",
          "commands": [
            "drizzle-kit migrate"
          ]
        }
      },
      "cache": false
    }
  },
  "tags": []
}
