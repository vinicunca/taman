{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@vinicunca/tsconfig/node-bundler.json",
  "compilerOptions": {
    // gen-auth-schema.ts pulls in apps/api sources, which use `.ts` import paths.
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "src",
    "drizzle.config.ts",
    "gen-auth-schema.ts"
  ],
  "exclude": ["node_modules"]
}
